<idea-plugin>
    <id>com.irumka.hft.optimizer</id>
    <name>HFT Memory Optimizer</name>
    <vendor email="support@hotpath.dev" url="https://hotpath.dev">HotPath Dev</vendor>

    <description><![CDATA[
      High-frequency trading memory layout optimizer, cache contention analyzer,
      STLF stall detector, SIMD Crash Guard, memory_order optimizer and Compiler Explorer bridge for C++.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="ui.HFTSettings"/>
        <projectService serviceImplementation="ui.VisualizationManager"/>

        <applicationConfigurable
                parentId="tools"
                instance="ui.HFTSettingsConfigurable"
                id="com.irumka.hft.optimizer.settings"
                displayName="HFT Optimizer"/>

        <toolWindow
                id="HFT Optimizer"
                secondary="true"
                anchor="right"
                factoryClass="ui.HFTToolWindowFactory"
                icon="AllIcons.Nodes.PpLibFolder"/>

        <editorFactoryListener implementation="dev.hotpath.HotPathHighlighter"/>

        <!-- Core Intentions -->
        <intentionAction>
            <className>dev.hotpath.HotPathHighlighter$Optimize</className>
            <category>C/C++ HFT Optimizations</category>
        </intentionAction>
        <intentionAction>
            <className>optimization.CacheLineAlignerIntention</className>
            <category>C/C++ HFT Optimizations</category>
        </intentionAction>
        <intentionAction>
            <className>optimization.CacheLineSplitFixerIntention</className>
            <category>C/C++ HFT Optimizations</category>
        </intentionAction>
        <intentionAction>
            <className>optimization.FalseSharingFixerIntention</className>
            <category>C/C++ HFT Optimizations</category>
        </intentionAction>
        <intentionAction>
            <className>optimization.HotColdSeparatorIntention</className>
            <category>C/C++ HFT Optimizations</category>
        </intentionAction>
        <intentionAction>
            <className>optimization.ReorganizeProducerConsumerIntention</className>
            <category>C/C++ HFT Optimizations</category>
        </intentionAction>
        <intentionAction>
            <className>optimization.ArrayFalseSharingFixerIntention</className>
            <category>C/C++ HFT Optimizations</category>
        </intentionAction>
        <intentionAction>
            <className>optimization.SIMDCrashGuardIntention</className>
            <category>C/C++ HFT Optimizations</category>
        </intentionAction>
        <intentionAction>
            <className>optimization.GlobalAtomicAlignerIntention</className>
            <category>C/C++ HFT Optimizations</category>
        </intentionAction>
        <intentionAction>
            <className>optimization.SpinloopPauseIntention</className>
            <category>C/C++ HFT Optimizations</category>
        </intentionAction>
        <intentionAction>
            <className>optimization.BitwiseMaskIntention</className>
            <category>C/C++ HFT Optimizations</category>
        </intentionAction>
        <intentionAction>
            <className>optimization.CompileTimeGuardIntention</className>
            <category>C/C++ HFT Optimizations</category>
        </intentionAction>

        <!-- Silicon & Concurrency Intentions -->
        <intentionAction>
            <className>optimization.BranchLikelyIntention</className>
            <category>C/C++ HFT Optimizations</category>
        </intentionAction>
        <intentionAction>
            <className>optimization.MemoryOrderFixerIntention</className>
            <category>C/C++ HFT Optimizations</category>
        </intentionAction>
        <intentionAction>
            <className>optimization.GodboltIntention</className>
            <category>C/C++ HFT Optimizations</category>
        </intentionAction>
    </extensions>
</idea-plugin>